#!/usr/bin/env bash
# Mimir receive-only launcher: scan, demo, frontend, tool and test.
set -euo pipefail
cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

readonly PY=.venv-scan/bin/python
readonly SDR_TOOLS=(
    calibrate_thresholds diagnose_threshold capture_to_vectorstore
    diagnose_pluto_gain diagnose_fingerprints compare_decode_rate
)

# Show the available commands without requesting confirmation.
usage() {
    cat <<'EOF'
MIMIR launcher (receive-only scanner)

  ./mimir scan [--device hackrf|plutosdr] live scan with the SDR plugged in
  ./mimir demo [file.sigmf-meta]          replay a saved capture, no SDR needed
  ./mimir frontend                        start the dashboard dev server (port 5173)
  ./mimir tool                            list the tools
  ./mimir tool <name> [args]              run a tool, e.g. ./mimir tool vectors snr
  ./mimir test                            run all the tests (pytest + Vitest)

Every command is shown first and runs only after you press Enter.
EOF
}

# Identify tools that open a receive-only SDR device.
uses_sdr() {
    local tool
    for tool in "${SDR_TOOLS[@]}"; do
        [[ "$1" != "$tool" ]] || return 0
    done
    return 1
}

# List public Python scripts and runnable packages together, with SDR warnings.
list_tools() {
    local path name
    while IFS= read -r -d '' name; do
        [[ "$name" != _* ]] || continue
        printf '  %s' "$name"
        if uses_sdr "$name"; then
            printf ' (uses the SDR)'
        fi
        printf '\n'
    done < <(
        for path in tools/*.py tools/*/__main__.py; do
            [[ -f "$path" ]] || continue
            if [[ "$path" == tools/*/__main__.py ]]; then
                name=${path%/__main__.py}
                name=${name##*/}
            else
                name=${path##*/}
                name=${name%.py}
            fi
            printf '%s\0' "$name"
        done | sort -zu
    )
}

# Require the scanner environment before displaying a runnable Python command.
require_python() {
    if [[ ! -x "$PY" ]]; then
        printf '%s\n' '.venv-scan is missing. Run ./setup.sh first.'
        exit 1
    fi
}

# Display an array as a safely quoted shell command.
show_command() {
    printf '  '
    printf '%q ' "$@"
    printf '\n'
}

# Print a rounded box, coloured on a terminal with NO_COLOR unset or empty,
# treating end of input as cancellation.
confirm() {
    local prompt='Press Enter to run, or Ctrl+C to cancel.'
    local border= width i
    width=$(( ${#prompt} + 4 ))
    for (( i=0; i<width; i++ )); do
        border+='─'
    done
    printf '╭%s╮\n│  ' "$border"
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        printf '\033[1;33m%s\033[0m' "$prompt"
    else
        printf '%s' "$prompt"
    fi
    printf '  │\n╰%s╯\n' "$border"
    if ! read -r; then
        printf '%s\n' 'Cancelled: no confirmation.'
        exit 1
    fi
}

subcommand=${1:-help}
if (( $# > 0 )); then
    shift
fi
case "$subcommand" in
    help|-h|--help)
        usage
        exit 0
        ;;
    scan)
        require_python
        command=(env PYTHONPATH=. "$PY" -s scan.py "$@")
        ;;
    demo)
        require_python
        demo_file=
        if [[ ${1:-} == *.sigmf-meta ]]; then
            demo_file=$1
            shift
            if [[ ! -f "$demo_file" ]]; then
                printf 'Demo file does not exist: %s\n' "$demo_file"
                exit 1
            fi
        elif [[ -d data/demo_cache ]]; then
            # Read cache entries newest first, preserving spaces in file names.
            while IFS= read -r -d '' entry; do
                cache=${entry#* }
                stem=${cache##*/}
                stem=${stem%.json}
                if [[ -f "data/captures/$stem.sigmf-meta" &&
                      -f "data/captures/$stem.sigmf-data" ]]; then
                    demo_file="data/captures/$stem.sigmf-meta"
                    printf 'Demo file: %s.sigmf-meta (newest with a cache)\n' "$stem"
                    break
                fi
            done < <(find data/demo_cache -maxdepth 1 -type f -name '*.json' \
                -printf '%T@ %p\0' | sort -z -nr)
        fi
        if [[ -z "$demo_file" ]]; then
            printf '%s\n' 'A demo needs a .sigmf-meta, its .sigmf-data and a data/demo_cache/<stem>.json.'
            exit 1
        fi
        command=(env PYTHONPATH=. "$PY" -s scan.py --demo --demo-files "$demo_file" "$@")
        ;;
    frontend)
        command=(npm run dev --prefix dashboard/frontend)
        ;;
    tool)
        if (( $# == 0 )); then
            list_tools
            exit 0
        fi
        requested=$1
        name=${requested%.py}
        shift
        # Refuse helpers, paths and directories without a package entry point.
        if [[ "$name" == _* || "$name" == */* ]] ||
           [[ ! -f "tools/$name.py" && ! -f "tools/$name/__main__.py" ]]; then
            printf 'No tool called %s\n' "$requested"
            list_tools
            exit 1
        fi
        require_python
        # Preserve file tools and launch runnable packages by module name.
        if [[ -f "tools/$name.py" ]]; then
            command=(env PYTHONPATH=. "$PY" -s "tools/$name.py" "$@")
        else
            command=(env PYTHONPATH=. "$PY" -s -m "tools.$name" "$@")
        fi
        ;;
    test)
        python_tests=(uv run pytest)
        frontend_tests=(npm run test --prefix dashboard/frontend)
        printf '%s\n' 'Will run:'
        show_command "${python_tests[@]}"
        show_command "${frontend_tests[@]}"
        confirm
        # Run both commands in order, stopping with the first failure's status.
        "${python_tests[@]}" || exit "$?"
        "${frontend_tests[@]}" || exit "$?"
        exit 0
        ;;
    *)
        printf 'Unknown command: %s\n' "$subcommand"
        usage
        exit 1
        ;;
esac

printf '%s\n' 'Will run:'
show_command "${command[@]}"
if [[ "$subcommand" == tool ]] && uses_sdr "$name"; then
    printf '%s\n' 'This tool opens the SDR (receive only).'
fi
confirm
exec "${command[@]}"
