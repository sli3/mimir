{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless",
        "--executable-path",
        "/home/sli3/.cache/ms-playwright/chromium_headless_shell-1228/chrome-headless-shell-linux64/chrome-headless-shell",
        "--no-sandbox"
      ]
    },
    "wiki-search": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "/home/sli3/Repository/mimir/mcp/wiki_search_mcp.py"
      ]
    }
  }
}
