# Mimir command rules for Codex. Mimir is receive-only under the
# Radiocommunications Act 1992 (Cth): Codex never touches the radio hardware,
# never runs the live scanner, ./mimir or the SDR tools, and never commits or pushes.
# The SDR tools are tools/capture and tools/diagnose (rf#87) and the old script
# names. Rules match whole arguments, not folder prefixes, so a new file under
# those folders must be added below by name; python -m and -c are refused outright.
# These are prefix rules, so they cannot see every spelling (for example a flag
# placed between python and the script). The Codex sandbox, pm's PROTECTED FILE
# CHECK and tests/test_no_transmit.py are the backstops.
# Check a command with:
#   codex execpolicy check --pretty --rules .codex/rules/mimir.rules -- <command>

prefix_rule(
    pattern = [[
        "hackrf_transfer", "hackrf_sweep", "hackrf_info", "hackrf_spiflash",
        "hackrf_cpldjtag", "hackrf_debug", "hackrf_clock", "hackrf_operacake",
        "hackrf_biast", "hackrf_tcxo",
    ]],
    decision = "forbidden",
    justification = "Mimir agents never touch the HackRF. hackrf_transfer can transmit; live hardware checks are Prin's.",
    match = ["hackrf_transfer -t file.iq -f 915000000", "hackrf_info"],
    not_match = ["uv run pytest"],
)

prefix_rule(
    pattern = [[
        "iio_attr", "iio_writedev", "iio_readdev", "iio_info", "iio_reg",
        "iio_genxml", "SoapySDRUtil", "rx_sdr", "tx_sdr",
    ]],
    decision = "forbidden",
    justification = "Mimir agents never touch the Pluto or any SDR. iio_writedev and tx_sdr can transmit.",
    match = ["iio_writedev -u usb:1.2.3 cf-ad9361-dds-core-lpc", "SoapySDRUtil --probe"],
)

prefix_rule(
    pattern = [[
        "python", "python3", ".venv/bin/python", ".venv/bin/python3",
        ".venv-scan/bin/python", ".venv-scan/bin/python3", "ipython", "ipython3",
    ], [
        "scan.py", "./scan.py",
        "tools/calibrate_thresholds.py", "tools/diagnose_threshold.py",
        "tools/capture_to_vectorstore.py", "tools/diagnose_pluto_gain.py",
        "tools/diagnose_fingerprints.py", "tools/compare_decode_rate.py",
        "tools/capture", "tools/capture/", "./tools/capture", "./tools/capture/",
        "tools/diagnose", "tools/diagnose/", "./tools/diagnose", "./tools/diagnose/",
        "tools/capture/__main__.py", "tools/diagnose/__main__.py",
        "tools/capture/calibrate_thresholds.py", "tools/capture/capture_to_vectorstore.py",
        "tools/diagnose/diagnose_threshold.py", "tools/diagnose/diagnose_pluto_gain.py",
        "tools/diagnose/diagnose_fingerprints.py", "tools/diagnose/compare_decode_rate.py",
        "capture", "diagnose",
    ]],
    decision = "forbidden",
    justification = "The scanner and the capture and diagnose tools open the SDR. Prin runs them himself.",
    match = [
        "python scan.py --demo",
        "python3 tools/diagnose_threshold.py",
        "python tools/capture calibrate",
        "python3 tools/diagnose/__main__.py gain",
        ".venv-scan/bin/python tools/capture/calibrate_thresholds.py",
    ],
    not_match = ["python3 tools/seed_chromadb.py", "python -m tools.vectors snr"],
)

prefix_rule(
    pattern = [[
        "python", "python3", ".venv/bin/python", ".venv/bin/python3",
        ".venv-scan/bin/python", ".venv-scan/bin/python3",
    ], ["-u", "-B", "-O", "-X", "-W", "-m", "-c", "-I", "-s", "-S", "-E", "-P", "-"]],
    decision = "forbidden",
    justification = "Interpreter flags hide which script runs, and -m or -c can start tools.capture or tools.diagnose under any module name. Codex runs Python without them.",
    match = [
        "python -u scan.py",
        "python -m tools.capture calibrate",
        "python3 -m tools.diagnose.gain",
        "python3 -c x",
        ".venv-scan/bin/python -s scan.py",
    ],
    not_match = ["python3 tools/seed_chromadb.py"],
)

prefix_rule(
    pattern = [[
        "python", "python3", ".venv/bin/python", ".venv/bin/python3",
        ".venv-scan/bin/python", ".venv-scan/bin/python3",
    ], [
        "tools/seed_chromadb.py", "./tools/seed_chromadb.py",
        "tools/archive/seed_chromadb.py", "./tools/archive/seed_chromadb.py",
    ]],
    decision = "forbidden",
    justification = "seed_chromadb.py wipes data/vectorstore with no backup. Prin runs it by hand.",
    match = ["python3 tools/seed_chromadb.py", "python tools/archive/seed_chromadb.py"],
    not_match = ["git diff tools/archive/seed_chromadb.py", "python3 tools/inspect_snr.py"],
)

prefix_rule(
    pattern = ["uv", "run", [
        "tools/seed_chromadb.py", "./tools/seed_chromadb.py",
        "tools/archive/seed_chromadb.py", "./tools/archive/seed_chromadb.py",
    ]],
    decision = "forbidden",
    justification = "Running seed_chromadb.py through uv still wipes data/vectorstore.",
    match = ["uv run tools/archive/seed_chromadb.py"],
    not_match = ["uv run pytest -q"],
)

prefix_rule(
    pattern = [["./tools/seed_chromadb.py", "tools/seed_chromadb.py", "./tools/archive/seed_chromadb.py", "tools/archive/seed_chromadb.py"]],
    decision = "forbidden",
    justification = "Running seed_chromadb.py directly still wipes data/vectorstore.",
    match = ["./tools/archive/seed_chromadb.py"],
)

prefix_rule(
    pattern = [["./mimir", "mimir", "env", "pytest", "py.test", "pypy", "pypy3"]],
    decision = "forbidden",
    justification = "./mimir starts the scanner and the SDR tools; env and the other runners can start any of them. pm runs the test suites, and Prin runs ./mimir himself.",
    match = ["./mimir scan", "./mimir tool calibrate_thresholds", "env PYTHONPATH=. python scan.py", "pytest tools/diagnose"],
    not_match = ["git status --short"],
)

prefix_rule(
    pattern = [["bash", "sh", "zsh", "fish"], ["./mimir", "mimir"]],
    decision = "forbidden",
    justification = "Running the launcher through a shell is still running ./mimir.",
    match = ["bash ./mimir scan", "sh mimir tool diagnose_threshold"],
)

prefix_rule(
    pattern = ["uv", "run", ["scan.py", "python", "python3", "-q", "--quiet", "--with", "--frozen"]],
    decision = "forbidden",
    justification = "Codex does not run the project's Python through uv: pm runs the test suites itself.",
    match = ["uv run scan.py", "uv run -q python scan.py", "uv run python tools/diagnose_threshold.py"],
    not_match = ["uv run pytest -q"],
)

prefix_rule(
    pattern = ["git", ["commit", "push", "reset", "rebase", "merge", "checkout", "switch", "stash", "tag", "restore", "clean", "rm", "mv"]],
    decision = "forbidden",
    justification = "Codex never changes git history, branches or the index. pm and Prin handle git.",
    match = ["git commit -m x", "git push origin main", "git clean -fdx"],
    not_match = ["git diff HEAD", "git status --short"],
)
